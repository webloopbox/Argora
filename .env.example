# Database
DATABASE_URL=postgres://brainstorm:brainstorm@localhost:5432/brainstorm

# Auth
JWT_SECRET=change-me-in-production-please
JWT_EXPIRES_IN=7d

# CORS - comma-separated list of allowed origins (Vite default below).
# To reach the dev server from another device on the LAN, add that origin too:
# WEB_ORIGIN=http://localhost:5173,http://192.168.1.239:5173
WEB_ORIGIN=http://localhost:5173

# API port
PORT=3000

# Node env
NODE_ENV=development

# LLM providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Gemini - API key from Google Cloud Console (enable "Generative Language API")
# or from Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
