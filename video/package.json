{
  "name": "brainstorm-video",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion promo/demo video for Brainstorm — IBM-styled animated captions + ElevenLabs voiceover.",
  "type": "module",
  "scripts": {
    "studio": "remotion studio",
    "dev": "remotion studio",
    "render": "remotion render BrainstormDemo out/brainstorm-demo.mp4 --codec=h264",
    "still": "remotion still BrainstormDemo out/frame.png --frame=90",
    "voiceover": "node scripts/generate-voiceover.mjs",
    "typecheck": "tsc --noEmit",
    "upgrade": "remotion upgrade"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "^4.0.0",
    "brainstorm": "file:..",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "typescript": "^5.6.3"
  }
}
