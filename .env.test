# E2E test environment — points to a separate test database.
# Create the DB once: psql -c "CREATE DATABASE brainstorm_test;"
# Then run migrations: pnpm --filter ./apps/api typeorm:run-migrations
#
# Fill in the credentials that match your local PostgreSQL setup.
DATABASE_URL=postgres://brainstorm:brainstorm@localhost:5432/brainstorm_test

JWT_SECRET=e2e-test-secret
JWT_EXPIRES_IN=7d
WEB_ORIGIN=http://localhost:5173
PORT=3000
NODE_ENV=test

# Leave empty — AI duplicate check is mocked via page.route() in the tests.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
